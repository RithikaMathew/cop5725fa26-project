# Copy this file to .env.
# On HiPerGator, start your PostgreSQL server, then run:
# /blue/cop5725/share/pg-tools/pg-info.sh
# Copy the DATABASE_URL line it prints into .env.
# For another PostgreSQL server, use that server's connection details.
DATABASE_URL=postgresql://user:password@host:5432/database
# Support Unicode SQL and HN text even when the server defaults to SQL_ASCII.
PGCLIENTENCODING=UTF8
