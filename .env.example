# Copy this file to .env and fill in real values. Never commit .env.
# DATABASE_URL: your PostgreSQL connection string. On HiPerGator, start your
# server and run /blue/cop5725/share/pg-tools/pg-info.sh, then copy the
# DATABASE_URL line it prints. For another server, use its connection details.
DATABASE_URL=postgresql://user:password@host:5432/database
# PGCLIENTENCODING: keeps Unicode HN text working when the server defaults to SQL_ASCII.
PGCLIENTENCODING=UTF8
# MAX_ROWS: row cap for load.py (newest comments of 2024 plus the stories in that
# window). The default of 200000 downloads and loads in about 8 minutes; 0 loads the full year (hours).
MAX_ROWS=200000
